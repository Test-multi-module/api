<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>net.testproj.db</groupId>
        <artifactId>db</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <groupId>net.testproj.db.schema</groupId>
    <artifactId>schema</artifactId>

    <properties>
        <!--suppress UnresolvedMavenProperty -->
        <db.url>${env.DB_URL}</db.url>
        <!--suppress UnresolvedMavenProperty -->
        <db.user>${env.DB_USER_NAME}</db.user>
        <!--suppress UnresolvedMavenProperty -->
        <db.password>${env.DB_PASSWORD}</db.password>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jooq</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>docker-compose-up</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>docker</executable>
                            <arguments>
                                <argument>compose</argument>
                                <argument>-f</argument>
                                <argument>${project.basedir}/../../docker-compose.yml</argument>
                                <argument>up</argument>
                                <argument>-d</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>wait-for-db</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <echo message="Waiting for database container healthcheck to become healthy (testproj_db)..."/>
                                <exec executable="powershell" osfamily="windows" failonerror="true">
                                    <arg value="-Command"/>
                                    <arg value="$deadline=(Get-Date).AddSeconds(60); while((Get-Date) -lt $deadline){ $s=(docker inspect -f '{{.State.Health.Status}}' testproj_db 2>$null); if($s -eq 'healthy'){ exit 0 }; Start-Sleep -Seconds 2 }; exit 1"/>
                                </exec>
                                <exec executable="sh" osfamily="unix" failonerror="true">
                                    <arg value="-c"/>
                                    <arg value="i=0; while [ $i -lt 30 ]; do s=$(docker inspect -f '{{.State.Health.Status}}' testproj_db 2>/dev/null || true); if [ x$s = xhealthy ]; then exit 0; fi; i=$((i+1)); sleep 2; done; exit 1"/>
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-maven-plugin</artifactId>
                <version>10.15.0</version>
                <dependencies>
                    <dependency>
                        <groupId>org.postgresql</groupId>
                        <artifactId>postgresql</artifactId>
                        <version>42.7.3</version>
                    </dependency>
                    <dependency>
                        <groupId>org.flywaydb</groupId>
                        <artifactId>flyway-database-postgresql</artifactId>
                        <version>10.15.0</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>auth-migration</id>
                        <goals><goal>migrate</goal></goals>
                        <phase>validate</phase>
                        <configuration>
                            <url>${db.url}</url>
                            <user>${db.user}</user>
                            <password>${db.password}</password>

                            <createSchemas>true</createSchemas>
                            <schemas>auth</schemas>
                            <defaultSchema>auth</defaultSchema>
                            <driver>org.postgresql.Driver</driver>

                            <locations>
                                <location>filesystem:src/main/resources/db/migration/auth</location>
                            </locations>
                        </configuration>
                    </execution>
                    <execution>
                        <id>public-migration</id>
                        <goals><goal>migrate</goal></goals>
                        <phase>validate</phase>
                        <configuration>
                            <url>${db.url}</url>
                            <user>${db.user}</user>
                            <password>${db.password}</password>

                            <createSchemas>true</createSchemas>
                            <schemas>public</schemas>
                            <defaultSchema>public</defaultSchema>
                            <driver>org.postgresql.Driver</driver>

                            <locations>
                                <location>filesystem:src/main/resources/db/migration/public</location>
                            </locations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jooq</groupId>
                <artifactId>jooq-codegen-maven</artifactId>
                <version>3.19.13</version>
                <dependencies>
                    <dependency>
                        <groupId>org.postgresql</groupId>
                        <artifactId>postgresql</artifactId>
                        <version>42.7.3</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <phase>generate-sources</phase>
                        <id>generate-public</id>
                        <goals><goal>generate</goal></goals>
                        <configuration>
                            <jdbc>
                                <driver>org.postgresql.Driver</driver>
                                <url>${db.url}</url>
                                <user>${db.user}</user>
                                <password>${db.password}</password>
                            </jdbc>
                            <generator>
                                <name>org.jooq.codegen.JavaGenerator</name>
                                <database>
                                    <name>org.jooq.meta.postgres.PostgresDatabase</name>
                                    <inputSchema>public</inputSchema>
                                </database>
                                <generate>
                                    <tables>true</tables>
                                </generate>
                                <target>
                                    <packageName>net.testproj.db.pb</packageName>
                                    <directory>${project.build.directory}/generated-sources/jooq</directory>                                </target>
                            </generator>
                        </configuration>
                    </execution>
                    <execution>
                        <phase>generate-sources</phase>
                        <id>generate-auth</id>
                        <goals><goal>generate</goal></goals>
                        <configuration>
                            <jdbc>
                                <driver>org.postgresql.Driver</driver>
                                <url>${db.url}</url>
                                <user>${db.user}</user>
                                <password>${db.password}</password>
                            </jdbc>
                            <generator>
                                <name>org.jooq.codegen.JavaGenerator</name>
                                <database>
                                    <name>org.jooq.meta.postgres.PostgresDatabase</name>
                                    <inputSchema>auth</inputSchema>
                                </database>
                                <generate>
                                    <tables>true</tables>
                                </generate>
                                <target>
                                    <packageName>net.testproj.db.auth</packageName>
                                    <directory>${project.build.directory}/generated-sources/jooq</directory>                                </target>
                            </generator>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>add-jooq-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-sources/jooq</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>