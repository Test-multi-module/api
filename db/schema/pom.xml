<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>net.testproj.db</groupId>
        <artifactId>db</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>schema</artifactId>

    <properties>
        <!--suppress UnresolvedMavenProperty -->
        <db.url>${env.DB_URL}</db.url>
        <!--suppress UnresolvedMavenProperty -->
        <db.user>${env.DB_USER_NAME}</db.user>
        <!--suppress UnresolvedMavenProperty -->
        <db.password>${env.DB_PASSWORD}</db.password>
        <jooq.generated-sources.directory>${project.build.directory}/generated-sources/jooq</jooq.generated-sources.directory>
        <db.driver>org.postgresql.Driver</db.driver>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jooq</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-maven-plugin</artifactId>
                <configuration>
                    <url>${db.url}</url>
                    <user>${db.user}</user>
                    <password>${db.password}</password>
                    <driver>${db.driver}</driver>
                    <createSchemas>true</createSchemas>
                </configuration>
                <executions>
                    <execution>
                        <id>auth-migration</id>
                        <goals><goal>migrate</goal></goals>
                        <phase>generate-sources</phase>
                        <configuration>
                            <schemas>auth</schemas>
                            <defaultSchema>auth</defaultSchema>
                            <locations>
                                <location>filesystem:src/main/resources/db/migration/auth</location>
                            </locations>
                        </configuration>
                    </execution>
                    <execution>
                        <id>api-migration</id>
                        <goals><goal>migrate</goal></goals>
                        <phase>generate-sources</phase>
                        <configuration>
                            <schemas>api</schemas>
                            <defaultSchema>api</defaultSchema>
                            <locations>
                                <location>filesystem:src/main/resources/db/migration/api</location>
                            </locations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jooq</groupId>
                <artifactId>jooq-codegen-maven</artifactId>
                <configuration>
                    <jdbc>
                        <driver>${db.driver}</driver>
                        <url>${db.url}</url>
                        <user>${db.user}</user>
                        <password>${db.password}</password>
                    </jdbc>
                    <generator>
                        <name>org.jooq.codegen.JavaGenerator</name>
                        <database>
                            <name>org.jooq.meta.postgres.PostgresDatabase</name>
                        </database>
                        <generate>
                            <tables>true</tables>
                        </generate>
                        <target>
                            <directory>${jooq.generated-sources.directory}</directory>
                        </target>
                    </generator>
                </configuration>
                <executions>
                    <execution>
                        <phase>generate-sources</phase>
                        <id>generate-api</id>
                        <goals><goal>generate</goal></goals>
                        <configuration>
                            <generator>
                                <database>
                                    <inputSchema>api</inputSchema>
                                </database>
                                <target>
                                    <packageName>net.testproj.db.api</packageName>
                                </target>
                            </generator>
                        </configuration>
                    </execution>
                    <execution>
                        <phase>generate-sources</phase>
                        <id>generate-auth</id>
                        <goals><goal>generate</goal></goals>
                        <configuration>
                            <generator>
                                <database>
                                    <inputSchema>auth</inputSchema>
                                </database>
                                <target>
                                    <packageName>net.testproj.db.auth</packageName>
                                </target>
                            </generator>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-jooq-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${jooq.generated-sources.directory}</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>windows-docker-db</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>ensure-windows-for-profile</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <condition property="is.windows">
                                            <os family="windows"/>
                                        </condition>
                                        <fail unless="is.windows"
                                              message="Maven profile 'widows-docker-db' is intended for Windows local development only. Do not use this run configuration on Linux/macOS."/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>check-docker</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>powershell</executable>
                                    <arguments>
                                        <argument>-ExecutionPolicy</argument>
                                        <argument>Bypass</argument>
                                        <argument>-File</argument>
                                        <argument>${project.basedir}/../../local-development/check-docker.ps1</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>docker-compose-up</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>docker</executable>
                                    <arguments>
                                        <argument>compose</argument>
                                        <argument>-f</argument>
                                        <argument>${project.basedir}/../../local-development/docker-compose.yml</argument>
                                        <argument>up</argument>
                                        <argument>-d</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>wait-for-db</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>powershell</executable>
                                    <arguments>
                                        <argument>-Command</argument>
                                        <argument>$deadline=(Get-Date).AddSeconds(60); while((Get-Date) -lt $deadline){ $s=(docker inspect -f '{{.State.Health.Status}}' testproj_db 2&gt;$null); if($s -eq 'healthy'){ exit 0 }; Start-Sleep -Seconds 2 }; exit 1</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>